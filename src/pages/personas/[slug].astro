---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DailyDoing from '../../components/DailyDoing.tsx';
import { PERSONAS } from '../../lib/personas.generated';

/**
 * Per-persona detail page — shows the static bundle info (name, description,
 * wertstrom, tags) plus the live "Daily Doing" card (P41.8) fetched
 * client-side from hermes-rest /public/personas/{key}/activity.
 *
 * Static routes are generated from src/lib/personas.generated.ts so every
 * persona in the registry gets its own page at /personas/<key>.
 */
export function getStaticPaths() {
  return PERSONAS.map((p) => ({
    params: { slug: p.key },
    props: { persona: p },
  }));
}

const { persona } = Astro.props;
---

<Layout
  title={`${persona.displayName} — Pommer Agents`}
  description={persona.descShort}
>
  <Header />

  <main class="bg-[#0d0d1a] text-white min-h-screen">
    <section class="max-w-4xl mx-auto py-12 px-6">
      <nav class="text-sm text-white/50 mb-6">
        <a href="/" class="hover:text-white transition-colors">Start</a>
        <span class="mx-2">/</span>
        <span class="text-white/80">{persona.displayName}</span>
      </nav>

      <header class="flex items-start gap-6 mb-10">
        <img
          src={persona.avatarUrl}
          alt={persona.displayName}
          width={96}
          height={96}
          class="rounded-2xl object-cover w-24 h-24"
        />
        <div>
          <h1 class="text-3xl font-bold">{persona.displayName}</h1>
          <p class="text-white/70 mt-1 max-w-xl">{persona.descShort}</p>
          <div class="mt-3 flex flex-wrap gap-2 text-xs">
            <span class="rounded bg-white/10 px-2 py-0.5">{persona.wertstrom}</span>
            {persona.tags.map((t) => (
              <span class="rounded bg-white/5 px-2 py-0.5 text-white/60">{t}</span>
            ))}
          </div>
        </div>
      </header>

      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <h2 class="text-lg font-semibold mb-2">Über</h2>
          <p class="text-sm text-white/70">
            {persona.descShort}
          </p>
          {!persona.customerFacing && (
            <p class="text-xs text-white/40 italic mt-3">
              Interne Persona — nicht direkt für Customer-Tenants buchbar.
            </p>
          )}
        </div>

        <div>
          <DailyDoing personaKey={persona.key} client:load />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
