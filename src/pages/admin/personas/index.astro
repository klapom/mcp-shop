---
/**
 * Admin Persona-Editor
 *
 * INTERN — nur über Cloudflare Access erreichbar (/admin/* und /agentfirm-api/* liegen in
 * der Access-App; Login mit einer freigegebenen E-Mail). Die Preact-Island läuft
 * client:only (statische Seite) und ruft die agentfirm Shop-API same-origin unter
 * /agentfirm-api auf; die API prüft das Access-JWT. Kein Token im Bundle.
 */
import Layout from '../../../layouts/Layout.astro';
import PersonaEditor from '../../../components/admin/PersonaEditor';
import AdminNav from '../../../components/admin/AdminNav.astro';
---

<Layout
  title="Admin — Persona-Editor"
  description="Internes Admin-Tool: Persona-Einstellungen bearbeiten und ausrollen (CF-Access-gated)."
>
  <!-- Admin-Banner -->
  <div class="bg-amber-500/10 border-b border-amber-500/20 px-4 py-2 text-center text-xs text-amber-300">
    <strong>Intern</strong> — Login über Cloudflare Access, nur freigegebene E-Mails. Die Seite
    spricht die Shop-API unter <code>/agentfirm-api</code> an; die prüft das Access-Login.
  </div>
  <AdminNav active="personas" />

  <!-- Client-only Preact island -->
  <PersonaEditor client:only="preact" />
</Layout>
