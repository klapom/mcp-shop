---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PortalUpload from '../../components/portal/PortalUpload.tsx';

/**
 * Wissensportal (Portal P1) — Tenant Self-Service Ingestion.
 *
 * Lives in the shop (shared gateway session) but the data path is separate: the
 * upload island talks directly to the BFF. Static page; all logic client-side.
 * Styled to the shop CI (petrol hero + light body), reachable from the OT MCP.
 */
---

<Layout
  title="Wissensportal"
  description="Eigene OMNITRACKER-Konfiguration hochladen und die Ingestion prüfen."
>
  <Header />

  <main>
    <!-- Hero — mirrors the product-page hero (petrol-dark) -->
    <section class="bg-petrol-dark text-white py-16 px-6">
      <div class="max-w-4xl mx-auto">
        <nav class="text-sm text-white/50 mb-6">
          <a href="/products" class="hover:text-white transition-colors">Produkte</a>
          <span class="mx-2">/</span>
          <a href="/products/ot" class="hover:text-white transition-colors">OMNITRACKER Knowledge</a>
          <span class="mx-2">/</span>
          <span class="text-white/80">Wissensportal</span>
        </nav>
        <h1 class="text-3xl md:text-4xl font-bold">Wissensportal</h1>
        <p class="mt-3 text-xl text-white/80 max-w-2xl">
          Lade deine OMNITRACKER-Konfiguration hoch und prüfe, was in deine Wissensbasis aufgenommen
          wurde.
        </p>
      </div>
    </section>

    <div class="max-w-3xl mx-auto px-6 py-12">
      <p class="text-sm text-grau">
        Unterstützt OMNITRACKER-Exporte (<span class="font-mono">.xoo</span> /
        <span class="font-mono">.xop</span>) und Archive. Die Ingestion läuft strikt tenant-isoliert;
        danach siehst du den Report, was erfasst wurde. Die hochgeladene Rohdatei wird nach der
        Verarbeitung sofort gelöscht.
      </p>

      <div class="mt-8">
        <PortalUpload client:load />
      </div>
    </div>
  </main>

  <Footer />
</Layout>
