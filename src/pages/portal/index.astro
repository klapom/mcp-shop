---
import Layout from '../../layouts/Layout.astro';
import PortalUpload from '../../components/portal/PortalUpload.tsx';

/**
 * Wissensportal (Portal P1) — Tenant Self-Service Ingestion.
 *
 * Lives in the shop (shared gateway session) but the data path is separate: the
 * upload island talks directly to the BFF. Static page; all logic client-side.
 */
---

<Layout
  title="Wissensportal"
  description="Eigene OmniTracker-Konfiguration hochladen und die Ingestion prüfen."
>
  <main class="min-h-screen bg-[#0d0d1a] px-6 py-16 text-white">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-2xl font-semibold">Wissensportal</h1>
      <p class="mt-2 text-sm text-white/60">
        Lade einen OmniTracker-Export (.xoo/.xop oder Archiv) hoch. Die Ingestion läuft
        tenant-isoliert; danach siehst du den Report, was erfasst wurde. Die Rohdatei wird nach der
        Verarbeitung sofort gelöscht.
      </p>

      <div class="mt-8">
        <PortalUpload client:load />
      </div>
    </div>
  </main>
</Layout>
