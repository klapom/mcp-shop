# Build-time
SITE_URL=https://shop.pommerconsulting.de
GATEWAY_URL=https://mcp.pommerconsulting.de

# Path to products.yaml (default: ../../mcp-platform/docs/inventory/products.yaml)
# Override for CI where the platform repo is checked out elsewhere
PRODUCTS_YAML_PATH=

# Pommer Personas API base URL (onboarding wizard)
# Dev: http://localhost:32050  |  Prod: https://personas-api.pommerconsulting.de
PUBLIC_POMMER_API_URL=http://localhost:32050

# Gateway base for the Persona-Approval BFF + in-browser OAuth-PKCE login (P86).
# Defaults (in gateway-auth.ts) target the staging gateway while the BFF lives
# there; point at https://mcp.pommerconsulting.de once it ships to prod.
PUBLIC_GATEWAY_URL=https://staging-mcp.pommerconsulting.de
# Public OAuth client registered on the gateway (redirect_uris: shop + localhost)
PUBLIC_GATEWAY_CLIENT_ID=Z1oL7KIihUxtk7n83VCQEpKBPENlGInvoJsaoIG6fHo
