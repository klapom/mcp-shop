# Build-time
SITE_URL=https://shop.pommerconsulting.de
GATEWAY_URL=https://mcp.pommerconsulting.de

# Path to products.yaml (default: ../../mcp-platform/docs/inventory/products.yaml)
# Override for CI where the platform repo is checked out elsewhere
PRODUCTS_YAML_PATH=

# Pommer Personas API base URL (onboarding wizard)
# Dev: http://localhost:32050  |  Prod: https://personas-api.pommerconsulting.de
PUBLIC_POMMER_API_URL=http://localhost:32050

# Gateway base for the Persona-Approval BFF + in-browser OAuth-PKCE login (P86).
# Defaults (in gateway-auth.ts) target the staging gateway while the BFF lives
# there; point at https://mcp.pommerconsulting.de once it ships to prod.
PUBLIC_GATEWAY_URL=https://staging-mcp.pommerconsulting.de
# Public OAuth client registered on the gateway (redirect_uris: shop + localhost)
PUBLIC_GATEWAY_CLIENT_ID=Z1oL7KIihUxtk7n83VCQEpKBPENlGInvoJsaoIG6fHo

# StandortIQ backend (Starlette on the DGX Spark) — the /products/standortiq/
# interactive tool calls it from the browser with the gateway JWT.
PUBLIC_STANDORTIQ_API_URL=https://api-standortiq.pommerconsulting.de

# OT performance-checkup portal (Track C). The /products/ot/ page deep-links to
# its logged-in entry; SSO via the shared WorkOS/gateway session (no token in URL).
# Currently the full deep-link is hardcoded in data/products.yaml — this var is
# noted for the future hostname cutover to app-ot-guru.
PUBLIC_OT_PERF_PORTAL_URL=https://app-ot-checkup.pommerconsulting.de

# ⚠️ LOCAL DEV ONLY — DO NOT set in CI/production.
# When set to the backend API_TOKEN, the StandortIQ tool skips the gateway
# login and calls the backend with this token directly, so you can test the
# report flow without WorkOS/gateway OAuth. Shipping this in a public build
# would expose the token to every visitor. Leave empty everywhere except your
# local .env.local.
PUBLIC_STANDORTIQ_DEV_TOKEN=
